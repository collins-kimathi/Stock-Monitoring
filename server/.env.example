# Copy this file to .env and fill in your real values. Never commit .env.

# Supabase / Postgres connection string.
# Find it in Supabase: Project Settings -> Database -> Connection string (URI, "Session" pooler works fine).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# Set to "true" if your Postgres host requires SSL (Supabase does).
DATABASE_SSL=true

# Port the Express API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your Vite dev server, deployed frontend URL, etc.)
CORS_ORIGIN=http://localhost:5173

# Used later (phase 6) to verify Supabase Auth JWTs sent from the frontend.
SUPABASE_JWT_SECRET=
